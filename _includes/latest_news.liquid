{% comment %}
  Cards for the newest posts in _data/news.yml.
  Usage: {% include latest_news.liquid limit=3 %}
  A post's optional `image` is a path under assets/img/ (e.g. news/act-africa.jpg).
{% endcomment %}
{% assign limit = include.limit | default: 3 %}
{% assign posts = site.data.news | sort: 'date' | reverse %}

<div class="latest-news">
  {% for post in posts limit: limit %}
    {% if post.url %}{% assign href = post.url %}{% else %}{% assign href = '/news/' | relative_url %}{% endif %}
    <article class="latest-news-card">
      <a class="latest-news-media{% unless post.image %} no-image{% endunless %}" href="{{ href }}"{% if post.url %} target="_blank" rel="noopener"{% endif %} tabindex="-1" aria-hidden="true">
        {% if post.image %}
          <img src="{% if post.image contains '://' %}{{ post.image }}{% else %}{{ post.image | prepend: 'assets/img/' | relative_url }}{% endif %}" alt="{{ post.image_alt | default: post.title }}"{% if post.image_position %} style="object-position: {{ post.image_position }}"{% endif %} loading="lazy">
        {% else %}
          <span class="latest-news-placeholder">{{ post.kind }}</span>
        {% endif %}
      </a>
      <div class="latest-news-body">
        <div class="news-post-meta">
          <span class="news-kind">{{ post.kind }}</span>
          {% if post.date.size == 10 %}
            <time datetime="{{ post.date }}">{{ post.date | date: '%b %-d, %Y' }}</time>
          {% else %}
            <time>{{ post.date }}</time>
          {% endif %}
        </div>
        <h3 class="latest-news-title">
          <a href="{{ href }}"{% if post.url %} target="_blank" rel="noopener"{% endif %}>{{ post.title }}</a>
        </h3>
        {% if post.venue %}<div class="news-venue">{{ post.venue }}</div>{% endif %}
      </div>
    </article>
  {% endfor %}
</div>
